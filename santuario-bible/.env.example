# Copia este archivo a `.env.local` y completa los valores. Nunca subas `.env.local` al repositorio.

# URL pública del proyecto en Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anon/publishable para el navegador (protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO para scripts de servidor/CLI como `npm run seed:verses`.
# Nunca exponer en el frontend ni usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Aporte voluntario (opcional) ──────────────────────────────────────────
# URL de pago a la que se abre el aporte (Mercado Pago, PayPal.me, Flow, etc.), en una pestaña nueva.
# Debe empezar con https://. Si tu enlace acepta el monto en la URL, usa {amount} donde va el número entero:
#   https://tu-medio-de-pago.example/pagar?monto={amount}
# Si la dejas vacía, el botón "Aportar" muestra un aviso amable de "pronto disponible".
NEXT_PUBLIC_OFFERING_URL=

# Texto del botón principal de aporte (opcional). Por defecto: "Aportar".
NEXT_PUBLIC_OFFERING_LABEL=
